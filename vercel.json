{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/games/search",
      "destination": "/api/games"
    },
    {
      "source": "/api/game-search",
      "destination": "/api/games"
    },
    {
      "source": "/api/submissions/:id",
      "destination": "/api/submissions?id=:id"
    },
    {
      "source": "/api/admin/submissions/:id",
      "destination": "/api/admin?action=submission_id&id=:id"
    },
    {
      "source": "/api/admin/users/:steamId",
      "destination": "/api/admin?action=user_steamId&steamId=:steamId"
    },
    {
      "source": "/api/admin/verify-submission",
      "destination": "/api/admin?action=verify-submission"
    },
    {
      "source": "/api/admin/submissions/mass-accept",
      "destination": "/api/admin?action=mass-accept"
    },
    {
      "source": "/api/admin/submissions/delete-batch",
      "destination": "/api/admin?action=delete-batch"
    },
    {
      "source": "/api/admin/submissions/export-csv",
      "destination": "/api/admin?action=export-csv"
    },
    {
      "source": "/api/admin/update-user-team",
      "destination": "/api/admin?action=update-user-team"
    },
    {
      "source": "/api/admin/update-user-role",
      "destination": "/api/admin?action=update-user-role"
    },
    {
      "source": "/api/admin/recalculate-all",
      "destination": "/api/admin?action=recalculate-all"
    },
    {
      "source": "/api/admin/repair-submissions",
      "destination": "/api/admin?action=repair-submissions"
    },
    {
      "source": "/api/admin/team-adjustments",
      "destination": "/api/admin?action=team-adjustments"
    },
    {
      "source": "/api/admin/activity-log",
      "destination": "/api/admin?action=activity-log"
    },
    {
      "source": "/api/admin/submissions",
      "destination": "/api/admin?action=submissions"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin?action=users"
    },
    {
      "source": "/api/admin/:subpath*",
      "destination": "/api/admin?subpath=:subpath*"
    },
    {
      "source": "/api/leaderboard/event/:id",
      "destination": "/api/leaderboards?id=:id"
    },
    {
      "source": "/api/leaderboard/:type*",
      "destination": "/api/leaderboards?type=:type*"
    },
    {
      "source": "/api/auth/steam/login",
      "destination": "/api/auth/steam?action=login"
    },
    {
      "source": "/api/auth/steam/url",
      "destination": "/api/auth/steam?action=url"
    },
    {
      "source": "/api/auth/steam/callback",
      "destination": "/api/auth/steam?action=callback"
    },
    {
      "source": "/api/auth/discord/url",
      "destination": "/api/auth/discord?action=url"
    },
    {
      "source": "/api/auth/discord/callback",
      "destination": "/api/auth/discord?action=callback"
    },
    {
      "source": "/api/auth/:provider",
      "destination": "/api/auth/[provider]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
